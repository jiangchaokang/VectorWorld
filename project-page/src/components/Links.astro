---
import { Icon } from "astro-icon/components";
import type { Link } from "../types/types";

interface Props {
  links?: Link[];
}

const { links = [] } = Astro.props;

function isPrimary(link: Link) {
  const key = `${link.name} ${link.icon ?? ""}`.toLowerCase();
  return key.includes("arxiv");
}
---

{
  links.length > 0 && (
    <div class="not-prose flex flex-wrap justify-center gap-3">
      {links.map((link) => {
        const primary = isPrimary(link);

        return (
          <a
            href={link.url}
            target="_blank"
            rel="noreferrer"
            aria-label={link.name}
            class:list={[
              "group hover:-translate-y-0.5",
              primary ? "vw-button-primary" : "vw-button-secondary",
            ]}
          >
            {link.icon && (
              <Icon
                name={link.icon}
                class:list={[
                  "h-4 w-4 shrink-0 transition duration-200",
                  primary ? "" : "text-ink-2 group-hover:text-ink-1",
                ]}
              />
            )}
            <span>{link.name}</span>
          </a>
        );
      })}
    </div>
  )
}