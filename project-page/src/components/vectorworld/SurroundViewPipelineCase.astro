---
import Video from "../Video.astro";

type BadgeTone = "blue" | "zinc";

interface Props {
  caseTitle: string;
  subtitle: string;
  badge: string;
  badgeTone?: BadgeTone;
  vectorSrc: string;
  layoutSrc: string;
  resultSrc: string;
  vectorCaption?: string;
  layoutCaption?: string;
  resultCaption?: string;
}

const {
  caseTitle,
  subtitle,
  badge,
  badgeTone = "blue",
  vectorSrc,
  layoutSrc,
  resultSrc,
  vectorCaption =
    "Compact control input. It stays visually lighter so the projected layout and final synthesis remain the focus.",
  layoutCaption =
    "Projected control signal in image space. This is the key bridge between the explicit vector scene and the video generator.",
  resultCaption =
    "Final surround-view synthesis conditioned on the projected layout prior.",
} = Astro.props;

const badgeClass =
  badgeTone === "blue"
    ? "bg-brand-soft text-brand"
    : "bg-surface-2 text-ink-2";

const frameHeightClass = "flex h-56 items-center justify-center md:h-64 xl:h-72";
---

<article class="vw-card p-5 md:p-6">
  <div class="mb-5 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h3 class="m-0 text-2xl font-semibold text-ink-1">
        {caseTitle}
      </h3>

      <p class="mt-1 text-sm leading-6 text-ink-2">
        {subtitle}
      </p>
    </div>

    <span class:list={["rounded-full px-3 py-1 text-xs font-medium", badgeClass]}>
      {badge}
    </span>
  </div>

  <div class="grid gap-4 xl:grid-cols-12">
    <section class="rounded-2xl border border-hairline bg-surface-2 p-4 xl:col-span-3">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold text-ink-1">
          Stage 1 · Vector scene
        </p>

        <span class="rounded-full bg-surface-3 px-2.5 py-1 text-xs font-medium text-ink-2">
          Control input
        </span>
      </div>

      <div class="overflow-hidden rounded-2xl border border-hairline bg-[var(--vw-canvas)]">
        <div class={frameHeightClass}>
          <Video
            src={vectorSrc}
            controls={true}
            autoplay={false}
            loop={false}
            muted={true}
            preload="none"
            class="!h-full !w-full object-contain"
          />
        </div>
      </div>

      <p class="mt-3 text-sm leading-6 text-ink-2">
        {vectorCaption}
      </p>
    </section>

    <section class="rounded-2xl border border-[color:var(--vw-accent-line)] bg-brand-soft p-4 xl:col-span-4">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold text-ink-1">
          Stage 2 · Projected layout
        </p>

        <span class="rounded-full bg-brand-soft px-2.5 py-1 text-xs font-medium text-brand">
          Explicit conditioning
        </span>
      </div>

      <div class="overflow-hidden rounded-2xl border border-[color:var(--vw-accent-line)] bg-[var(--vw-canvas)]">
        <div class={frameHeightClass}>
          <Video
            src={layoutSrc}
            controls={true}
            autoplay={false}
            loop={false}
            muted={true}
            preload="none"
            class="!h-full !w-full object-contain"
          />
        </div>
      </div>

      <p class="mt-3 text-sm leading-6 text-ink-2">
        {layoutCaption}
      </p>
    </section>

    <section class="rounded-2xl border border-hairline bg-surface-2 p-4 xl:col-span-5">
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-sm font-semibold text-ink-1">
          Stage 3 · Surround-view result
        </p>

        <span class="rounded-full bg-surface-3 px-2.5 py-1 text-xs font-medium text-ink-2">
          Final output
        </span>
      </div>

      <div class="overflow-hidden rounded-2xl border border-hairline bg-[var(--vw-canvas)]">
        <div class={frameHeightClass}>
          <Video
            src={resultSrc}
            controls={true}
            autoplay={false}
            loop={false}
            muted={true}
            preload="none"
            class="!h-full !w-full object-contain"
          />
        </div>
      </div>

      <p class="mt-3 text-sm leading-6 text-ink-2">
        {resultCaption}
      </p>
    </section>
  </div>
</article>