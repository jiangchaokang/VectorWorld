---
interface Props {
  size?: string;
  class?: string;
}

const { size = "1em", class: className = "" } = Astro.props;

const uid = `vw-${Math.random().toString(36).slice(2, 9)}`;
const glow = `${uid}-glow`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={`vw-vectorworld-icon ${className}`}
  fill="none"
  aria-hidden="true"
>
  <defs>
    <radialGradient id={glow} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.9" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- tile: the 64m x 64m frontier -->
  <rect
    x="4.5"
    y="4.5"
    width="55"
    height="55"
    rx="15"
    fill="currentColor"
    fill-opacity="0.06"
    stroke="currentColor"
    stroke-opacity="0.28"
    stroke-width="1.4"
  />

  <!-- streaming frontier edge (dashed, completion ahead of ego) -->
  <path
    d="M20 19 H44"
    stroke="currentColor"
    stroke-opacity="0.4"
    stroke-width="2"
    stroke-linecap="round"
    stroke-dasharray="0.1 6"
  />

  <!-- lane / route edges converging to the ego state -->
  <path
    d="M20 19 C 22 32, 26 40, 32 47"
    stroke="currentColor"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-opacity="0.85"
  />
  <path
    d="M44 19 C 42 32, 38 40, 32 47"
    stroke="currentColor"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-opacity="0.85"
  />

  <!-- frontier graph nodes -->
  <circle cx="20" cy="19" r="3.6" fill="currentColor" fill-opacity="0.92" />
  <circle cx="44" cy="19" r="3.6" fill="currentColor" fill-opacity="0.55" />

  <!-- ego state node (warm start), highlighted -->
  <circle cx="32" cy="47" r="11" fill={`url(#${glow})`} fill-opacity="0.35" />
  <circle
    cx="32"
    cy="47"
    r="5.4"
    fill="currentColor"
    stroke="var(--vw-surface-1, #fff)"
    stroke-width="1.6"
  />
</svg>

<style>
  .vw-vectorworld-icon {
    display: block;
    flex: none;
    color: var(--vw-accent);
    transition:
      transform var(--dur-base, 0.4s) var(--ease, ease),
      color var(--dur-base, 0.4s) var(--ease, ease);
  }

  .vw-vectorworld-icon:hover {
    transform: translateY(-1px);
  }
</style>
