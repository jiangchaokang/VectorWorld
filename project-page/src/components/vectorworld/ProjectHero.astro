---
import Authors from "../Authors.astro";
import Links from "../Links.astro";
import Notes from "../Notes.astro";
import ThemeToggle from "../ThemeToggle.astro";
import VectorWorldWordmark from "./VectorWorldWordmark.astro";
import HeroVectorField from "./HeroVectorField.astro";
import type { Author, Link, Note } from "../../types/types";

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
  description?: string;
  highlights?: string[];
}

const {
  title,
  authors,
  conference,
  notes,
  links,
  description,
  highlights = [],
} = Astro.props;

const [candidateBrand, candidateRest] = title.split(/:\s*/, 2);
const brand = candidateRest ? candidateBrand.trim() : "";
const subtitle = candidateRest ? candidateRest.trim() : title;
const heroHighlights = highlights.slice(0, 4);
const showBrandIcon = brand.trim().toLowerCase() === "vectorworld";
---

<header class="mx-auto mb-12 px-6 md:mb-16" style="max-width: 92rem;">
  <div class="vw-hero-shell px-6 py-8 md:px-12 md:py-12">
    <HeroVectorField />

    <div class="mb-8 flex items-center justify-between gap-4">
      <span class="vw-eyebrow">Streaming World Model</span>
      <ThemeToggle />
    </div>

    <div class="mx-auto max-w-5xl text-center">
      <div class="not-prose mb-6 flex justify-center" data-reveal>
        <span class="vw-eyebrow vw-eyebrow--plain text-[0.7rem] text-ink-3">
          ICML 2026 · Spotlight
        </span>
      </div>

      {brand && (
        <div class="vw-hero-brand-wrap" data-reveal data-reveal-delay="40">
          <span class="vw-hero-brand">
            {showBrandIcon ? (
              <VectorWorldWordmark title={brand} iconSize="0.92em" />
            ) : (
              <span class="vw-hero-brand-fallback">{brand}</span>
            )}
          </span>
        </div>
      )}

      <h1
        class={brand ? "vw-hero-subtitle" : "vw-hero-title"}
        data-reveal
        data-reveal-delay="80"
      >
        {brand && <span class="sr-only">{brand}: </span>}
        {subtitle}
      </h1>

      {description && (
        <p
          class="not-prose vw-lead mx-auto mt-6 max-w-3xl"
          data-reveal
          data-reveal-delay="120"
        >
          {description}
        </p>
      )}

      <div
        class="not-prose mt-8 flex flex-col items-center gap-5"
        data-reveal
        data-reveal-delay="160"
      >
        <Authors authors={authors} />

        <div class="flex flex-wrap items-center justify-center gap-3">
          {conference && <span class="vw-eyebrow">{conference}</span>}
          {notes && notes.length > 0 && <Notes notes={notes} />}
        </div>

        {links && links.length > 0 && <Links links={links} />}
      </div>
    </div>

    {heroHighlights.length > 0 && (
      <div class="not-prose mx-auto mt-10 grid max-w-6xl gap-3 md:grid-cols-2 xl:grid-cols-4">
        {heroHighlights.map((item, index) => (
          <article
            class="vw-hero-highlight-card"
            data-reveal
            data-reveal-delay={String(180 + index * 60)}
          >
            <div class="vw-hero-highlight-index">
              {String(index + 1).padStart(2, "0")}
            </div>
            <p class="vw-hero-highlight-copy">{item}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</header>
